# Neon Postgres connection string (pooled). Required in production.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Random secret used to hash client IPs: sha256(ip + IP_HASH_SALT). Required in production.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Public site URL, used for absolute OG/meta URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: copy every signup into a Google Sheet. See integrations/google-sheet/README.md.
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# SHEETS_WEBHOOK_SECRET=

# Local development / tests only: use an in-memory store instead of Postgres.
# WAITLIST_DB=memory
